# Copia este fichero a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca se versiona.

# URL base de la API (el api-gateway). Si se omite, se usa
# `${protocol}//${hostname}:8080`, que sirve para desarrollo local.
VITE_API_URL=http://localhost:8080

# No se usa hoy: el login de Google pasa por el backend
# (POST /api/v1/auth/oauth2/google). Se deja documentado para cuando se
# implemente el flujo OAuth directo desde el navegador.
# VITE_GOOGLE_CLIENT_ID=
