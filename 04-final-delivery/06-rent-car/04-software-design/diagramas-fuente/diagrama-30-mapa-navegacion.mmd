graph TD
    subgraph PUB["Público - sin sesión"]
        HOME["/ - Home<br/>contenido + buscador"]
        CAT["/vehicles - Catálogo"]
        DET["/vehicles/:id - Detalle de vehículo"]
        LOGIN["/auth/login"]
        REG["/auth/register"]
        FORGOT["/auth/forgot-password"]
    end

    subgraph AUTH["Autenticado - cualquier rol"]
