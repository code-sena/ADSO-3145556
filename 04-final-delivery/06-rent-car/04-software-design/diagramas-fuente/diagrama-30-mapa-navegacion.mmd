        BRANCH["/admin/branches - Sucursales"]
        ARESV["/admin/reservations - Panel de reservas"]
        INS["/admin/insurance-types - Tipos de seguro"]
        TRACK["/admin/tracking/:rentalId - Seguimiento"]
